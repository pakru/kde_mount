<!--
  ShareForm.qml is embedded from src/kcm/ui/ on purpose: it is one file
  serving both front ends, and the KCM's own resource is generated by
  kcmutils_add_qml_kcm() globbing that directory. Referencing it here rather
  than copying it is what keeps the two entry points from drifting apart
  again. Both aliases land in the same directory of this binary's resource
  tree so main.qml can instantiate ShareForm by plain name.

  SPDX-License-Identifier: GPL-3.0-or-later
-->
<RCC>
    <qresource prefix="/nasmount">
        <file alias="main.qml">qml/main.qml</file>
        <file alias="ShareForm.qml">../kcm/ui/ShareForm.qml</file>
    </qresource>
</RCC>
