[Unit]
Description=Arm saved network mounts for the graphical session
# graphical-session.target rather than default.target: KWallet is unlocked as
# part of the graphical session, and the passwords live there. PartOf= means a
# session teardown stops this unit too. graphical-session.target is active
# while ANY graphical session of this user is running, so teardown correctly
# happens only after the last one (plan §7.1).
After=graphical-session.target
PartOf=graphical-session.target
# Best-effort ordering only. plasma-kwallet-pam.service is Type=simple, so it
# counts as "started" the moment pam_kwallet_init spawns — the actual unlock
# completes asynchronously after that, and was measured still pending 2.5s
# later. The supervisor therefore polls for the wallet itself; this ordering
# just avoids starting before the unlocker has even been launched. Harmless on
# systems where the unit does not exist.
After=plasma-kwallet-pam.service

[Service]
Type=oneshot
# Always active for the graphical session, not only while some share has
# Reconnect=true — a share armed by hand still needs ExecStopPost to disarm it
# at logout (plan §7.1).
RemainAfterExit=yes
ExecStart=@KDE_INSTALL_FULL_BINDIR@/nasmount-supervisor --start
# ExecStopPost, not ExecStop: ExecStop is skipped when ExecStart fails or
# times out, which would strand shares armed earlier in the same run.
ExecStopPost=@KDE_INSTALL_FULL_BINDIR@/nasmount-supervisor --stop
# Shares are armed one by one; an unreachable server should not hold the
# session up indefinitely.
TimeoutStartSec=120

[Install]
WantedBy=graphical-session.target
