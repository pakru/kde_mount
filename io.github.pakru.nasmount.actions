[Domain]
Name=nasmount
Icon=drive-network

# Every mutation here is auth_admin. A share is boot-owned and persistent,
# and its credential is stored root-owned on disk indefinitely (design §7) --
# the equivalent by hand is sudo-editing /etc, so creating or removing one
# requires authentication exactly like that would.
#
# There is no passwordless (Policy=yes) mutation tier any more. There used to
# be one, for sign-in-scoped shares: those were armed by a per-session
# supervisor at login, and any prompting policy would have popped an
# authentication dialog on every single login, so define/undefine/arm/disarm
# were allow_active=yes. That whole mode is gone -- shares are armed at boot
# by nasmount-boot, which runs as root and authorizes nothing -- and with it
# the only reason to keep an unauthenticated mutation. Do not reintroduce one
# without the login-prompt argument that justified it.
#
# Design §7.1 describes these as "auth_admin_keep" (briefly caching admin auth
# so several actions in a row do not each re-prompt), but kauth-policy-gen's
# own Policy-value grammar (invent.kde.org/frameworks/kauth
# src/policy-gen/policy-gen.cpp) only ever accepts yes|no|auth_self|auth_admin
# -- it has never generated a "_keep" .policy entry, even though polkit itself
# understands one. Plain auth_admin is used here instead: strictly more
# conservative (it re-prompts every time rather than caching), never less.
#
# inventory stays Policy=yes: it is read-only, caller-scoped, and the KCM
# refreshes it constantly -- prompting there would make the module unusable.
# PolicyInactive=no keeps everything off non-active and remote sessions.
[io.github.pakru.nasmount.definesystem]
Name=Define a boot-time network mount
Description=Authentication is required to define a boot-time network mount
Policy=auth_admin
PolicyInactive=no

[io.github.pakru.nasmount.undefinesystem]
Name=Remove a boot-time network mount definition
Description=Authentication is required to remove a boot-time network mount definition
Policy=auth_admin
PolicyInactive=no

[io.github.pakru.nasmount.inventory]
Name=List network mount health
Description=Authentication is required to list network mount health
Policy=yes
PolicyInactive=no

[io.github.pakru.nasmount.purge]
Name=Purge all nasmount data
Description=Administrator authentication is required to remove all nasmount shares and data
Policy=auth_admin
PolicyInactive=no
